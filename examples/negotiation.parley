# PARLEY v0 — example: route negotiation with a hybrid contract
# (machine clause 'check' + natural-language clause 'nl')

agent "planner-42" as PLANNER
agent "dispatcher-backup" as BACKUP
agent "dispatcher-7" as DISPATCHER
provides "route.plan" v1
  input  origin : Location
  input  dest   : Location
  output route  : Route
  cost   latency_ms <= 200
  default_confidence 0.9

# --- 1) Request with contract (NL + structured) -----------------------------
PLANNER -> DISPATCHER
  request route.plan
  intent "I need the fastest route, the user is in a hurry"
  with origin = "Lisboa", dest = "Porto"
  by 2026-10-22T15:00:00Z
  tenant "acme"
  expect confidence > 0.85
  expect route.eta_min <= 150
  expect nl "Route must avoid roads with announced roadworks in the next 24h" w 0.9
  fallback -> "dispatcher-backup"

# --- 2) Proposal (counter-offer) --------------------------------------------
DISPATCHER -> PLANNER
  propose route.plan
  parent "@msg1"
  with route = {"eta_min": 142, "stops": ["Lisboa", "Coimbra", "Viseu", "Porto"]}, cost_eur = 1.40
  confidence 0.93
  note "Viseu has roadworks; the alternate route via Aveiro is +40 min"
  tenant "acme"

# --- 3) Selective acceptance: accepts the NL clause, silent on the rest ------
PLANNER -> DISPATCHER
  accept route.plan
  clauses "c3"
  provenance "@msg1", "@msg2"
  tenant "acme"