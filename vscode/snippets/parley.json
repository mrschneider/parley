{
  "agente": {
    "prefix": "agent",
    "body": ["agent \"${1:id-estavel}\" as ${2:ALIAS}"],
    "description": "Declara um agente com alias local"
  },
  "capability": {
    "prefix": "provides",
    "body": [
      "provides \"${1:route.plan}\" v${2:1}",
      "  input  ${3:origin} : ${4:Location}",
      "  output ${5:route}  : ${6:Route}"
    ],
    "description": "Declara uma capability com contrato input/output"
  },
  "request": {
    "prefix": "request",
    "body": [
      "${1:PLANNER} -> ${2:DISPATCHER}",
      "  request ${3:route.plan}",
      "  intent \"${4:...}\"",
      "  with ${5:origin} = \"${6:Lisboa}\", ${7:dest} = \"${8:Porto}\"",
      "  by ${9:2026-10-22T15:00:00Z}"
    ],
    "description": "Pedido com contrato (abre a thread)"
  },
  "propose": {
    "prefix": "propose",
    "body": [
      "${1:DISPATCHER} -> ${2:PLANNER}",
      "  propose ${3:route.plan}",
      "  parent \"@msg1\"",
      "  with ${4:route} = {${5:...}}",
      "  confidence ${6:0.93}"
    ],
    "description": "Proposta contra um request"
  },
  "accept": {
    "prefix": "accept",
    "body": [
      "${1:PLANNER} -> ${2:DISPATCHER}",
      "  accept ${3:route.plan}",
      "  clauses \"${4:c3}\"",
      "  provenance \"@msg1\", \"@msg2\""
    ],
    "description": "Aceite (torna cláusulas 'nl' vinculantes)"
  },
  "expect": {
    "prefix": "expect",
    "body": ["expect ${1:confidence} > ${2:0.85} w ${3:0.9}"],
    "description": "Cláusula de contrato (check, ponderada)"
  },
  "expect-nl": {
    "prefix": "expectnl",
    "body": ["expect nl \"${1:Rota deve evitar obras nas próximas 24h}\" w ${2:0.9}"],
    "description": "Cláusula em linguagem natural (víncula só se aceita em ACCEPT)"
  }
}
