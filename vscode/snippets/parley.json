{
  "agent": {
    "prefix": "agent",
    "body": ["agent \"${1:stable-id}\" as ${2:ALIAS}"],
    "description": "Declares an agent with a local alias"
  },
  "capability": {
    "prefix": "provides",
    "body": [
      "provides \"${1:route.plan}\" v${2:1}",
      "  input  ${3:origin} : ${4:Location}",
      "  output ${5:route}  : ${6:Route}"
    ],
    "description": "Declares a capability with an input/output contract"
  },
  "request": {
    "prefix": "request",
    "body": [
      "${1:PLANNER} -> ${2:DISPATCHER}",
      "  request ${3:route.plan}",
      "  intent \"${4:...}\"",
      "  with ${5:origin} = \"${6:Lisbon}\", ${7:dest} = \"${8:Porto}\"",
      "  by ${9:2026-10-22T15:00:00Z}"
    ],
    "description": "Request with a contract (opens the thread)"
  },
  "propose": {
    "prefix": "propose",
    "body": [
      "${1:DISPATCHER} -> ${2:PLANNER}",
      "  propose ${3:route.plan}",
      "  parent \"@msg1\"",
      "  with ${4:route} = {${5:...}}",
      "  confidence ${6:0.93}"
    ],
    "description": "Proposal against a request"
  },
  "accept": {
    "prefix": "accept",
    "body": [
      "${1:PLANNER} -> ${2:DISPATCHER}",
      "  accept ${3:route.plan}",
      "  clauses \"${4:c3}\"",
      "  provenance \"@msg1\", \"@msg2\""
    ],
    "description": "Accept (makes 'nl' clauses binding)"
  },
  "expect": {
    "prefix": "expect",
    "body": ["expect ${1:confidence} > ${2:0.85} w ${3:0.9}"],
    "description": "Contract clause (check, weighted)"
  },
  "expect-nl": {
    "prefix": "expectnl",
    "body": ["expect nl \"${1:Route must avoid roadworks in the next 24h}\" w ${2:0.9}"],
    "description": "Natural-language clause (binds only if accepted in ACCEPT)"
  }
}
